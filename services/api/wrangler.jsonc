{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seigyo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production-simulation",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,https://seigyo.cord-pail.workers.dev,https://myshop.cord-pail.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SIMULATION", "class_name": "SimulationStateObject" }
    ]
  },
  "exports": {
    "SimulationStateObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
