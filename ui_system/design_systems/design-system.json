{
  "project": {
    "name": "Seigyo and MyShop",
    "type": "Operational incident recovery plus causal commerce environment",
    "audience": "Incident responders, engineering teams, judges, and shoppers",
    "stack": "React 19, Tailwind 4, beUI source, Radix, Motion, Recharts",
    "assumptions": [
      "The user selected Black Vector.",
      "The user asked the implementing agent to complete the build."
    ]
  },
  "selectedOptions": {
    "personality": "personality-vector",
    "color": "color-primary",
    "type": "type-control",
    "density": "density-selected",
    "shape": "shape-vector",
    "layering": "layering-primary",
    "motion": "motion-control",
    "icons": "icons-selected",
    "imagery": "imagery-vector",
    "layout": "layout-primary",
    "navigation": "navigation-control",
    "buttons": "buttons-selected",
    "forms": "forms-vector",
    "tables": "tables-primary",
    "surfaces": "surfaces-control",
    "feedback": "feedback-selected",
    "accessibility": "accessibility-vector",
    "voice": "voice-primary",
    "implementation": "implementation-control",
    "adaptation": "adaptation-selected"
  },
  "designPrinciples": [
    "Evidence before action",
    "Human authority at the consequence boundary",
    "Connected operational regions",
    "Editorial imagery carries MyShop",
    "Motion explains state and never performs urgency"
  ],
  "tokens": {
    "color": {
      "canvas": {
        "$type": "color",
        "$value": "#101318"
      },
      "surface1": {
        "$type": "color",
        "$value": "#151A21"
      },
      "surface2": {
        "$type": "color",
        "$value": "#1B212A"
      },
      "interactive": {
        "$type": "color",
        "$value": "#222A34"
      },
      "border": {
        "$type": "color",
        "$value": "#343D49"
      },
      "text": {
        "$type": "color",
        "$value": "#F4F7FA"
      },
      "supporting": {
        "$type": "color",
        "$value": "#C8D0DA"
      },
      "muted": {
        "$type": "color",
        "$value": "#A6B0BD"
      },
      "tertiary": {
        "$type": "color",
        "$value": "#8793A3"
      },
      "action": {
        "$type": "color",
        "$value": "#86AEF8"
      },
      "success": {
        "$type": "color",
        "$value": "#77D59A"
      },
      "warning": {
        "$type": "color",
        "$value": "#F1C06A"
      },
      "danger": {
        "$type": "color",
        "$value": "#FF7A77"
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": "4px"
      },
      "md": {
        "$type": "dimension",
        "$value": "6px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "8px"
      }
    }
  },
  "accessibilityDefaults": {
    "focus": "2px action-blue outline",
    "mobileTarget": "44px minimum",
    "minimumText": "11px",
    "reducedMotion": true,
    "statusUsesText": true,
    "chartTableFallback": true
  },
  "motionRules": {
    "baseDurationMs": 170,
    "maxRoutineDurationMs": 220,
    "noPulsingSeverity": true
  },
  "contentVoice": {
    "seigyo": "Direct operational utility copy",
    "myshop": "Concise material-led editorial copy"
  },
  "implementationRules": {
    "componentBase": "beUI source adapted over shadcn and Radix",
    "icons": "Lucide, Simple Icons, and original SVG only",
    "surfaces": "Opaque with hairline borders",
    "cards": "Only when the region itself is an interaction"
  },
  "thirdPartyAdaptation": {
    "preserve": [
      "accessible semantics",
      "keyboard behavior",
      "license notices"
    ],
    "replace": [
      "colors",
      "radius",
      "copy",
      "spacing",
      "decorative effects"
    ]
  },
  "researchReferences": [
    "ui-001",
    "ui-008",
    "ui-018",
    "ui-020",
    "ui-022",
    "ui-025",
    "ui-039",
    "ui-041",
    "lib-001",
    "lib-002",
    "lib-004",
    "ds-001",
    "ds-002",
    "ds-004",
    "ds-008"
  ],
  "myshopTokens": {
    "color": {
      "canvas": "#15120F",
      "surface1": "#1B1713",
      "surface2": "#231E19",
      "interactive": "#2B251F",
      "border": "#40382F",
      "text": "#F5F0E8",
      "supporting": "#D5CDC1",
      "muted": "#B5AB9E",
      "tertiary": "#9D9285",
      "accent": "#D2B48A"
    }
  },
  "typography": {
    "seigyo": {
      "base": "14px",
      "operational": "12px to 13px",
      "minimum": "11px",
      "pageHeading": "28px"
    },
    "myshop": {
      "base": "15px",
      "body": "14px to 15px",
      "controls": "12px",
      "minimum": "11px"
    }
  },
  "rules": {
    "layout": "Connected operational regions",
    "components": "Accessible behavior first",
    "motion": "Productive and reduced-motion safe",
    "content": "Direct and specific",
    "imagery": "Original editorial photography",
    "disabledControls": "Use explicit foreground, background, and border colors instead of whole-control opacity"
  }
}